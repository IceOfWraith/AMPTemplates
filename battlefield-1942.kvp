Meta.DisplayName=Battlefield 1942 [bot]
Meta.Description=Battlefield 1942 Dedicated Server (Linux standalone server 1.6 with the 1.61b patch, from the PCGamingWiki community files)
Meta.OS=Windows, Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=amp-template-bot
Meta.URL=https://www.pcgamingwiki.com/wiki/Battlefield_1942
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=battlefield-1942config.json
Meta.MetaConfigManifest=battlefield-1942metaconfig.json
Meta.ConfigRoot=battlefield-1942.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian-12
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RequiredOnWindows,RecommendedOnLinux
Meta.ContainerPolicyReason=The server is a 32-bit Linux build that needs the 32-bit libc6 and libncurses5 libraries. Using a container avoids the need for you to install these on the host. The Windows server is only available as an InstallShield installer that can't be installed unattended, so the Linux server is used on Windows too and a container is required there.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["libc6:i386","libncurses5:i386"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release
Meta.BreakingReleaseNotes=
Meta.AppConfigId=00caa146-714c-4e0a-b7a7-0a883f8f8558
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
