Meta.DisplayName=World of Warcraft (AzerothCore)
Meta.Description=AzerothCore World of Warcraft 3.3.5a (Wrath of the Lich King) server emulator, built from source with a bundled MySQL database
Meta.OS=Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=IceOfWraith
Meta.URL=https://www.azerothcore.org/
Meta.DisplayImageSource=url:https://avatars.githubusercontent.com/u/20147732?v=4
Meta.EndpointURIFormat=
Meta.ConfigManifest=azerothcoreconfig.json
Meta.MetaConfigManifest=azerothcoremetaconfig.json
Meta.ConfigRoot=azerothcore.kvp
Meta.MinAMPVersion=2.6.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=AzerothCore is compiled from source on every update. A container provides the compiler and libraries (clang, cmake, Boost, OpenSSL, zlib, bzip2, readline, ncurses, libaio, libnuma) without installing them on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["clang","cmake","make","libssl-dev","libbz2-dev","zlib1g-dev","libreadline-dev","libncurses-dev","libboost-dev","libboost-filesystem-dev","libboost-program-options-dev","libboost-iostreams-dev","libboost-regex-dev","libaio1t64","libnuma1","libncurses6"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=Initial release. The first update compiles AzerothCore and downloads about 1.3 GB, which can take 30-60 minutes.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=0d217665-cd9b-4bca-8640-b2da3cd6c09b
Meta.ImportableExtensions=[".conf"]
Meta.AppIsMultiIPAware=False
App.DisplayName=World of Warcraft (AzerothCore)
App.RootDir=./azerothcore/
App.BaseDirectory=./azerothcore/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=
App.LinuxCommandLineArgs="{{$FullInstanceDir}}amp-start.sh"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"AMP_REALM_NAME":"{{RealmName}}","AMP_REALM_ADDRESS":"{{RealmAddress}}","AC_BIND_IP":"{{$ApplicationIPBinding}}","AC_REALM_SERVER_PORT":"{{$AuthPort}}","AC_WORLD_SERVER_PORT":"{{$WorldPort}}","AC_DATA_DIR":"{{$FullBaseDir}}server/data","AC_LOGS_DIR":"{{$FullBaseDir}}server/logs","AC_UPDATES_ENABLE_DATABASES":"0","AC_PLAYER_LIMIT":"{{$MaxUsers}}","AC_GAME_TYPE":"{{GameType}}","AC_EXPANSION":"{{Expansion}}","AC_CHARACTERS_PER_REALM":"{{CharactersPerRealm}}","AC_START_PLAYER_LEVEL":"{{StartPlayerLevel}}","AC_START_HEROIC_PLAYER_LEVEL":"{{StartHeroicPlayerLevel}}","AC_START_PLAYER_MONEY":"{{StartPlayerMoney}}","AC_MAX_PRIMARY_TRADE_SKILL":"{{MaxPrimaryTradeSkill}}","AC_RATE_XP_KILL":"{{RateXPKill}}","AC_RATE_XP_QUEST":"{{RateXPQuest}}","AC_RATE_XP_EXPLORE":"{{RateXPExplore}}","AC_RATE_REST_IN_GAME":"{{RateRest}}","AC_RATE_REST_OFFLINE_IN_TAVERN_OR_CITY":"{{RateRest}}","AC_RATE_REST_OFFLINE_IN_WILDERNESS":"{{RateRest}}","AC_RATE_DROP_MONEY":"{{RateDropMoney}}","AC_RATE_DROP_ITEM_UNCOMMON":"{{RateDropItemUncommon}}","AC_RATE_DROP_ITEM_RARE":"{{RateDropItemRare}}","AC_RATE_DROP_ITEM_EPIC":"{{RateDropItemEpic}}","AC_RATE_HONOR":"{{RateHonor}}","AC_RATE_REPUTATION_GAIN":"{{RateReputationGain}}","AC_ALLOW_TWO_SIDE_ACCOUNTS":"{{AllowTwoSideAccounts}}","AC_ALLOW_TWO_SIDE_INTERACTION_CHAT":"{{CrossFaction}}","AC_ALLOW_TWO_SIDE_INTERACTION_CHANNEL":"{{CrossFaction}}","AC_ALLOW_TWO_SIDE_INTERACTION_GROUP":"{{CrossFaction}}","AC_ALLOW_TWO_SIDE_INTERACTION_GUILD":"{{CrossFaction}}","AC_ALLOW_TWO_SIDE_INTERACTION_CALENDAR":"{{CrossFaction}}","AC_ALLOW_TWO_SIDE_INTERACTION_ARENA":"{{CrossFaction}}","AC_ALLOW_TWO_SIDE_INTERACTION_AUCTION":"{{CrossFaction}}","AC_INSTANT_FLIGHT_PATHS":"{{InstantFlightPaths}}","AC_ALL_FLIGHT_PATHS":"{{AllFlightPaths}}","AC_WARDEN_ENABLED":"{{WardenEnabled}}","AC_PRELOAD_ALL_NON_INSTANCED_MAP_GRIDS":"{{PreloadAllNonInstancedMapGrids}}"}
App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=60
App.ExitString=server exit
App.ExitFile=
App.RestartDelaySeconds=0
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
