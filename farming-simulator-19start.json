        "UpdateSourceArgs": "-NoProfile -ExecutionPolicy Bypass -File \"farming-simulator-19activate.ps1\" -Key \"{{ActivationKey}}\" -GameDir \"{{$FullBaseDir}}game\"",
        "SkipOnFailure": false
    }
