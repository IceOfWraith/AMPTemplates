[
    {
        "UpdateStageName": "SteamCMD Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "SteamCMD",
        "UpdateSourceData": "648800",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "ForceDownloadPlatform": "Windows",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Create Config Directory",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}RDS_Data/config",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Initialise Wine",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"WINEPREFIX=\\\"{{$FullRootDir}}.wine\\\" WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init --update\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Install Wine Mono",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"/usr/bin/wine --version; ls /usr/share/wine/mono /opt/wine/mono 2>&1; strings /usr/lib/wine/x86_64-windows/appwiz.cpl /opt/wine-stable/lib/wine/x86_64-windows/appwiz.cpl 2>/dev/null | grep -i -m5 mono\"",
        "SkipOnFailure": true
    },
    {
        "UpdateStageName": "Check Server File",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "Executable",
        "UpdateSourceData": "cmd.exe",
        "UpdateSourceArgs": "/C if exist \"{{$FullBaseDir}}RaftDedicatedServer.exe\" (echo RaftDedicatedServer.exe found) else (echo RaftDedicatedServer.exe not found. Download it from master.raftmodding.com, upload it into the server folder with the File Manager, then start the server & exit /B 1)",
        "SkipOnFailure": true
    },
    {
        "UpdateStageName": "Check Server File",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"if [[ -f \\\"{{$FullBaseDir}}RaftDedicatedServer.exe\\\" ]]; then echo 'RaftDedicatedServer.exe found'; else echo 'RaftDedicatedServer.exe not found. Download it from master.raftmodding.com, upload it into the server folder with the File Manager, then start the server'; exit 1; fi\"",
        "SkipOnFailure": true
    }
]
